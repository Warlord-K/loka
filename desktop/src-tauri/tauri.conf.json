{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loka",
  "version": "0.1.0",
  "identifier": "dev.ygpt.loka",
  "build": {
    "beforeBuildCommand": "./src-tauri/scripts/prepare-sidecar.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/loka-agent",
      "binaries/loka-api"
    ],
    "resources": {
      "../scripts/slack_session.py": "scripts/slack_session.py",
      "../scripts/slack_watch.py": "scripts/slack_watch.py",
      "../scripts/slack_mcp.py": "scripts/slack_mcp.py",
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon-rgba.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": "Loka.entitlements",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwQzRGNDk3MjczMTE3QzMKUldUREZ6RW5sL1RFZ0pFdVFSVGVvTVJMZTdDWmdyOG9uVXJ5MDVIQkF1aERhZFNnQWRaZHE2VTkK",
      "endpoints": [
        "https://loka.ygpt.dev/updates/free/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
